# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/
*.xcuserstate
*.xcuserdatad/

## Obj-C/Swift specific
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

## Build generated
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

## Various settings
*.xccheckout
*.xcscmblueprint

## Xcode workspace shared data should be committed; per-user data should not
*.xcworkspace/xcuserdata/

## Swift Package Manager
.build/
.swiftpm/
Package.resolved

## SwiftPM sandbox workaround (workspace-local caches)
.swiftpm-home/

## CocoaPods (not used, but ignored defensively)
Pods/

## Carthage (not used, but ignored defensively)
Carthage/Build/

## Accio dependency management
Dependencies/
.accio/

## fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

## Code Injection
iOSInjectionProject/

## macOS
.DS_Store
.AppleDouble
.LSOverride
._*

## Misc / editor
*.swp
*.swo
*~
.idea/
.vscode/
